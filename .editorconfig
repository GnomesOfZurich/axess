# EditorConfig — see https://editorconfig.org
# Keeps whitespace + line endings consistent across editors/contributors.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{toml,yml,yaml,json}]
indent_size = 2

[*.md]
# Markdown trailing whitespace can be meaningful (`<space><space>` = hard
# break). Leave it alone.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
