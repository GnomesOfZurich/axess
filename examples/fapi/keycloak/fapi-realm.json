{
  "realm": "fapi",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "defaultSignatureAlgorithm": "ES256",
  "components": {
    "org.keycloak.keys.KeyProvider": [
      {
        "name": "fapi-es256",
        "providerId": "ecdsa-generated",
        "subComponents": {},
        "config": {
          "priority": ["200"],
          "enabled": ["true"],
          "active": ["true"],
          "ecdsaEllipticCurveKey": ["P-256"]
        }
      }
    ]
  },
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "emailVerified": true,
      "email": "alice@bank.example.com",
      "firstName": "Alice",
      "lastName": "Example",
      "credentials": [
        {
          "type": "password",
          "value": "alice",
          "temporary": false
        }
      ],
      "realmRoles": ["default-roles-fapi", "portfolio-viewer"],
      "groups": ["/finance-team"]
    }
  ],
  "groups": [
    {
      "name": "finance-team",
      "path": "/finance-team"
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "portfolio-viewer",
        "description": "Read-only access to portfolio data"
      }
    ]
  },
  "clients": [
    {
      "clientId": "axess-fapi-client",
      "name": "Axess FAPI Example",
      "description": "Demo client for the axess FAPI 2.0 example",
      "enabled": true,
      "protocol": "openid-connect",
      "clientAuthenticatorType": "client-jwt",
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": [
        "http://localhost:3000/auth/callback",
        "http://127.0.0.1:3000/auth/callback"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://127.0.0.1:3000"
      ],
      "fullScopeAllowed": true,
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "require.pushed.authorization.requests": "true",
        "dpop.bound.access.tokens": "true",
        "post.logout.redirect.uris": "http://localhost:3000/##http://127.0.0.1:3000/##http://localhost:3000##http://127.0.0.1:3000",
        "access.token.lifespan": "300",
        "client.session.idle.timeout": "1800",
        "client.session.max.lifespan": "36000",
        "id.token.as.detached.signature": "false",
        "tls.client.certificate.bound.access.tokens": "false",
        "require.signed.request.object": "false",
        "token.endpoint.auth.signing.alg": "ES256",
        "id.token.signed.response.alg": "ES256",
        "use.jwks.url": "false",
        "use.jwks.string": "true",
        "jwks.string": "{\"keys\":[{\"kty\":\"EC\",\"crv\":\"P-256\",\"use\":\"sig\",\"alg\":\"ES256\",\"kid\":\"axess-fapi-dev\",\"x\":\"HiI8V1SnTSnlNMRkv8zqiQSkiaJWKdJkD1CkbT8sw-o\",\"y\":\"KtRmBq3QlSwL1wNqngYMrf9j7cn9I0k-0tgqjt1FS4Y\"}]}"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ],
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email"
      ],
      "optionalClientScopes": [
        "offline_access",
        "address",
        "phone",
        "microprofile-jwt"
      ]
    }
  ]
}
